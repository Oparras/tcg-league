generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  STORE_OWNER
  ADMIN
}

enum PresenceStatus {
  AVAILABLE
  UNAVAILABLE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  LEFT
  REMOVED
}

enum StoreMembershipRole {
  MEMBER
  CAPTAIN
  OWNER
}

enum StoreJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchMode {
  IN_PERSON
  ONLINE
}

enum MatchStatus {
  PROPOSED
  ACCEPTED
  PLAYED_PENDING_CONFIRMATION
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_PROPOSED
  CANCELLED
  EXPIRED
}

enum MatchConfirmationStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum EventStatus {
  UPCOMING
  OPEN_REGISTRATION
  FULL
  FINISHED
  CANCELLED
}

enum EventRegistrationStatus {
  REGISTERED
  WAITLIST
  CANCELLED
  CHECKED_IN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum NotificationType {
  STORE_REQUEST
  STORE_REQUEST_RESOLVED
  CHALLENGE_RECEIVED
  CHALLENGE_UPDATED
  MATCH_RESULT_PENDING
  MATCH_CONFIRMED
  MATCH_DISPUTED
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  NEW_MESSAGE
  EVENT_REMINDER
  SYSTEM
}

enum LinkedAccountType {
  SOCIAL
  GAME
  PLATFORM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id                     String                    @id @default(cuid())
  email                  String                    @unique
  passwordHash           String?
  emailVerified          DateTime?
  role                   UserRole                  @default(PLAYER)
  image                  String?
  playerProfile          PlayerProfile?
  ownedStores            Store[]                   @relation("StoreOwner")
  storeMemberships       StoreMembership[]
  sentJoinRequests       StoreJoinRequest[]        @relation("StoreJoinRequester")
  reviewedJoinRequests   StoreJoinRequest[]        @relation("JoinRequestResponder")
  sentChallenges         Challenge[]               @relation("ChallengeChallenger")
  receivedChallenges     Challenge[]               @relation("ChallengeChallenged")
  matchesAsPlayerA       Match[]                   @relation("MatchPlayerA")
  matchesAsPlayerB       Match[]                   @relation("MatchPlayerB")
  wonMatches             Match[]                   @relation("MatchWinner")
  lostMatches            Match[]                   @relation("MatchLoser")
  reportedMatches        Match[]                   @relation("MatchReporter")
  resultConfirmations    MatchResultConfirmation[]
  disputesRaised         Dispute[]                 @relation("DisputeRaisedBy")
  disputesAssigned       Dispute[]                 @relation("DisputeAssignedTo")
  disputesResolved       Dispute[]                 @relation("DisputeResolvedBy")
  friendshipsSent        Friendship[]              @relation("FriendshipRequester")
  friendshipsReceived    Friendship[]              @relation("FriendshipAddressee")
  chatsAsUserA           Chat[]                    @relation("ChatUserA")
  chatsAsUserB           Chat[]                    @relation("ChatUserB")
  messagesSent           Message[]
  notifications          Notification[]            @relation("NotificationRecipient")
  triggeredNotifications Notification[]            @relation("NotificationActor")
  createdEvents          Event[]                   @relation("EventCreator")
  eventRegistrations     EventRegistration[]
  linkedAccounts         LinkedAccount[]
  accounts               Account[]
  sessions               Session[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
}

model PlayerProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  nick                String           @unique
  displayName         String
  city                String
  avatarUrl           String?
  bio                 String?
  status              PresenceStatus   @default(AVAILABLE)
  eloGlobal           Int              @default(1000)
  matchesPlayed       Int              @default(0)
  wins                Int              @default(0)
  losses              Int              @default(0)
  winRate             Float            @default(0)
  onboardingCompleted Boolean          @default(false)
  mainGameId          String?
  primaryStoreId      String?
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainGame            Game?            @relation("PrimaryGame", fields: [mainGameId], references: [id], onDelete: SetNull)
  primaryStore        Store?           @relation("PrimaryStore", fields: [primaryStoreId], references: [id], onDelete: SetNull)
  gameStats           PlayerGameStat[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([eloGlobal(sort: Desc)])
}

model PlayerGameStat {
  id              String        @id @default(cuid())
  playerProfileId String
  gameId          String
  elo             Int           @default(1000)
  matchesPlayed   Int           @default(0)
  wins            Int           @default(0)
  losses          Int           @default(0)
  winRate         Float         @default(0)
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  game            Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([playerProfileId, gameId])
  @@index([gameId, elo(sort: Desc)])
}

model Game {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String          @unique
  description     String?
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  primaryPlayers  PlayerProfile[] @relation("PrimaryGame")
  playerStats     PlayerGameStat[]
  supportedStores StoreGame[]
  challenges      Challenge[]
  matches         Match[]
  events          Event[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Store {
  id             String           @id @default(cuid())
  ownerId        String?
  name           String
  slug           String           @unique
  logoUrl        String?
  bannerUrl      String?
  city           String
  region         String?
  country        String?
  address        String
  description    String?
  websiteUrl     String?
  officialLocatorUrl String?
  googleMapsUrl  String?
  discordUrl     String?
  instagramUrl   String?
  isVerified     Boolean          @default(false)
  owner          User?            @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  supportedGames StoreGame[]
  memberships    StoreMembership[]
  joinRequests   StoreJoinRequest[]
  primaryMembers PlayerProfile[]  @relation("PrimaryStore")
  homeChallenges Challenge[]      @relation("ChallengeStore")
  events         Event[]
  playerAMatches Match[]          @relation("MatchStoreA")
  playerBMatches Match[]          @relation("MatchStoreB")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([name])
  @@index([city])
  @@index([region])
  @@index([country])
}

model StoreGame {
  id         String   @id @default(cuid())
  storeId    String
  gameId     String
  isFeatured Boolean  @default(false)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([storeId, gameId])
}

model StoreMembership {
  id        String              @id @default(cuid())
  userId    String
  storeId   String
  status    MembershipStatus    @default(ACTIVE)
  role      StoreMembershipRole @default(MEMBER)
  isPrimary Boolean             @default(false)
  joinedAt  DateTime            @default(now())
  leftAt    DateTime?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId, status])
}

model StoreJoinRequest {
  id            String                 @id @default(cuid())
  userId        String
  storeId       String
  message       String?
  status        StoreJoinRequestStatus @default(PENDING)
  respondedById String?
  requestedAt   DateTime               @default(now())
  respondedAt   DateTime?
  updatedAt     DateTime               @updatedAt
  user          User                   @relation("StoreJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  respondedBy   User?                  @relation("JoinRequestResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@unique([userId, storeId])
  @@index([storeId, status])
}

model Challenge {
  id                 String          @id @default(cuid())
  challengerId       String
  challengedId       String
  gameId             String
  storeId            String?
  format             String
  mode               MatchMode
  locationLabel      String?
  scheduledFor       DateTime
  counterProposedFor DateTime?
  message            String?
  status             ChallengeStatus @default(PENDING)
  respondedAt        DateTime?
  expiresAt          DateTime?
  challenger         User            @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged         User            @relation("ChallengeChallenged", fields: [challengedId], references: [id], onDelete: Cascade)
  game               Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  venueStore         Store?          @relation("ChallengeStore", fields: [storeId], references: [id], onDelete: SetNull)
  match              Match?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([challengedId, status])
  @@index([scheduledFor])
}

model Match {
  id               String                  @id @default(cuid())
  challengeId      String?                 @unique
  playerAId        String
  playerBId        String
  winnerId         String?
  loserId          String?
  playerAScore     Int?
  playerBScore     Int?
  reportedById     String?
  gameId           String
  format           String
  mode             MatchMode
  locationLabel    String?
  storeAId         String?
  storeBId         String?
  scheduledFor     DateTime?
  playedAt         DateTime?
  proofImageUrl    String?
  status           MatchStatus             @default(PROPOSED)
  playerAEloBefore Int                     @default(1000)
  playerAEloAfter  Int?
  playerBEloBefore Int                     @default(1000)
  playerBEloAfter  Int?
  confirmedAt      DateTime?
  challenge        Challenge?              @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  playerA          User                    @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB          User                    @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  winner           User?                   @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loser            User?                   @relation("MatchLoser", fields: [loserId], references: [id], onDelete: SetNull)
  reportedBy       User?                   @relation("MatchReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  game             Game                    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  storeA           Store?                  @relation("MatchStoreA", fields: [storeAId], references: [id], onDelete: SetNull)
  storeB           Store?                  @relation("MatchStoreB", fields: [storeBId], references: [id], onDelete: SetNull)
  confirmations    MatchResultConfirmation[]
  disputes         Dispute[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, scheduledFor])
  @@index([gameId, status])
}

model MatchResultConfirmation {
  id        String                  @id @default(cuid())
  matchId   String
  userId    String
  status    MatchConfirmationStatus @default(PENDING)
  note      String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  match     Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Event {
  id                   String               @id @default(cuid())
  storeId              String
  gameId               String
  createdById          String
  name                 String
  slug                 String               @unique
  description          String
  format               String
  location             String?
  startAt              DateTime
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  maxParticipants      Int
  status               EventStatus          @default(UPCOMING)
  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  game                 Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy            User                 @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  registrations        EventRegistration[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([storeId, startAt])
  @@index([gameId, status])
}

model EventRegistration {
  id          String                  @id @default(cuid())
  eventId     String
  userId      String
  status      EventRegistrationStatus @default(REGISTERED)
  checkedInAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Chat {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userA         User      @relation("ChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([userAId, userBId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  body      String
  link      String?
  payload   Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
}

model LinkedAccount {
  id                String            @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              LinkedAccountType @default(GAME)
  displayName       String?
  metadata          Json?
  connectedAt       DateTime          @default(now())
  lastSyncedAt      DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Dispute {
  id             String        @id @default(cuid())
  matchId        String
  raisedById     String
  assignedToId   String?
  resolvedById   String?
  reason         String
  evidenceUrl    String?
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedBy       User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  assignedTo     User?         @relation("DisputeAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy     User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
